{
    "name": "syofyanzuhad/filament-connection-indicator",
    "description": "A real-time connection signal indicator for Filament panels.",
    "keywords": [
        "syofyanzuhad",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "connection-indicator"
    ],
    "homepage": "https://github.com/syofyanzuhad/filament-connection-indicator",
    "support": {
        "issues": "https://github.com/syofyanzuhad/filament-connection-indicator/issues",
        "source": "https://github.com/syofyanzuhad/filament-connection-indicator"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Syofyan Zuhad",
            "email": "syofyanzuhad@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Syofyanzuhad\\ConnectionIndicator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Syofyanzuhad\\ConnectionIndicator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Syofyanzuhad\\ConnectionIndicator\\ConnectionIndicatorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
